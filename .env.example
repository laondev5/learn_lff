# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lff-lms?retryWrites=true&w=majority

# Auth
# Generate one per environment: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here
# Public origin of the site. In production this must be the live https domain,
# e.g. https://learn.livingfaithfoundation.org — never localhost, or sign-in
# cookies and every emailed link (onboarding, password reset) point at your laptop.
NEXTAUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Pusher
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Email (Nodemailer SMTP) — use an app password, not a real account password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="LFF LMS <your_email@gmail.com>"

# Paystack
PAYSTACK_SECRET_KEY=your_secret_key

# Google Calendar / Meet (teacher calendar connect)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# YouTube upload (optional; leave unset to disable the upload-to-YouTube feature)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Onboarding temporary passwords, in hours (default 72)
TEMPORARY_PASSWORD_TTL_HOURS=72

# App
# Keep this identical to NEXTAUTH_URL so links emailed to users point at the live site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-off admin seeding (scripts/seed-admin.ts). Pass these in the shell, do not
# save them here, and expect the account to change the password on first login.
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_PASSWORD=
